# TruthLens Flask backend environment variables
# Copy this file to .env and edit as needed.

# Secret key used to sign session cookies. CHANGE THIS to a long random string.
SECRET_KEY=change-this-to-a-long-random-secret-string

# Path to the SQLite database file (created automatically on first run).
DATABASE_PATH=data/truthlens.db

# Path where trained model + vectorizer are stored.
MODEL_DIR=models

# Folder that holds the dataset CSV files for training.
# Put your labelled news CSV files here (see README for the expected format).
DATASET_DIR=dataset

# Comma-separated list of allowed frontend origins for CORS.
# In development, set this to the Vite dev server URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true to print extra logs while debugging.
FLASK_DEBUG=true
